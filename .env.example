# ─── Admin dashboard ─────────────────────────────────────────
# Required to enable /admin login.
ADMIN_PASSWORD=change-me

# Optional: separate secret for signing session cookies.
# Defaults to ADMIN_PASSWORD if unset. Rotate this to log everyone out.
ADMIN_SESSION_SECRET=

# ─── Storage backend ─────────────────────────────────────────
# Auto: "supabase" when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set,
# otherwise "file" (JSON files in ./data).
# Force a driver by uncommenting:
# STORAGE_DRIVER=file
# STORAGE_DRIVER=supabase

# Supabase (project settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Chat (Moonshot LLM) ─────────────────────────────────────
# Optional. When unset the chat modal shows a "coming soon" fallback.
MOONSHOT_API_KEY=

# ─── Image generator ─────────────────────────────────────────
# Required for `npm run gen:images`. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
